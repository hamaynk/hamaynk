{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "src/env.d.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
	  "jsx": "preserve",
		"jsxImportSource": "astro",
	  "strictNullChecks": true,
		"allowJs": true,
    "types": ["unplugin-icons/types/astro"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	}
}
