---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteName, siteLang, themeColor } from "@/data/config";
import type { LayoutProps as Props } from "@/types";
import HamaynkGroup from '@/assets/images/hamaynk-group-photo.png';

const baseUrl = Astro.url.href;
const { title, seoTitle, seoDescription, description, noindex = false } = Astro.props;

const finalOgImage = `/images/og-image.png`;
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		<meta name="seoDescription" content={seoDescription} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="author" href="humans.txt" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={siteName} />
		<link rel="manifest" href="/site.webmanifest" />

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${seoTitle} | ${siteName}`} />
		<meta property="og:image" content={finalOgImage} />
		<meta property="og:description" content={seoDescription} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLang} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={`${seoTitle} | ${siteName}`} />
		<meta name="twitter:description" content={description} />
		<!-- <meta name="twitter:image" content={finalOgImage} /> -->

		<link rel="preload" as="font" type="font/woff2" href="/fonts/caveat-brush/caveat-brush-v12-latin-regular.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/nunito/nunito-v32-latin-regular.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/nunito/nunito-v32-latin-500.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/nunito/nunito-v32-latin-600.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/nunito/nunito-v32-latin-700.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/nunito/nunito-v32-latin-900.woff2" crossorigin />

		<link rel="preload" as="image" href={HamaynkGroup.src} />
		<link rel="preload" as="video" href="/hamaynk-video-hero.mp4">

		<script
            is:inline
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="ee08ab0c-eebd-4c16-af40-b4ebb89fa418">
        </script>

		<title>{title} | {siteName}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	import "@tailwindplus/elements";
</script>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.getElementById("main-header");

		if (header) {
			const updateHeaderHeight = () => {
				document.documentElement.style.setProperty("--header-height", `${header.offsetHeight}px`);
			};

			updateHeaderHeight();
			window.addEventListener("resize", updateHeaderHeight);
		}
	});
</script>
