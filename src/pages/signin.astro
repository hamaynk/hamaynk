---
import Button from "@/components/buttons/Button.astro";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";

let message = "";
let messageType: "error" | "success" = "error";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString() || "";

    if (!email) {
      message = "Please enter a valid email address.";
      messageType = "error";
    } else {
      const authorizedEmails = (import.meta.env.AUTHORIZED_EMAILS || "")
        .split(",")
        .map((e: string) => e.trim());

      if (!authorizedEmails.includes(email.trim())) {
        message = "This email is not authorized to access this page.";
        messageType = "error";
      } else {
        // Call the signin API endpoint
        const response = await fetch(
          `${import.meta.env.SITE_URL || "http://localhost:4321"}/api/auth/signin`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ email }),
          }
        );

        const data = await response.json();

        if (response.ok && data.success) {
          return Astro.redirect(
            `/check-email?email=${encodeURIComponent(email)}`
          );
        } else {
          message = data.error || "Failed to send sign-in link";
          messageType = "error";
        }
      }
    }
  } catch (err) {
    message = `Error: ${err instanceof Error ? err.message : "Unknown error"}`;
    messageType = "error";
  }
}

// Check for error query param
const urlParams = new URL(Astro.request.url).searchParams;
const errorParam = urlParams.get('error');
if (errorParam) {
  message = errorParam;
  messageType = "error";
}

const title = "Sign In | Events Approval";
const seoTitle = "Sign In for Authorized Users to Log In";
const seoDescription = "Sign in for authorized users to log in for event approval";
---

<Layout {title} {seoTitle} {seoDescription}>
    <Section class:list={"bg-neutral-50"}>
		<Container>
			<SectionHeading>
			<h1 class="text-4xl font-bold tracking-wide">Sign in to approve events as an authorized administrator</h1>
			</SectionHeading>
			<p class="text-gray-600 mb-8">
            Enter your email to receive a magic sign-in link.
          </p>

          {message && (
            <div
              class={`mb-6 p-4 rounded-2xl text-sm font-medium ${
                messageType === "error"
                  ? "bg-red-50 text-red-700 border border-red-200"
                  : "bg-green-50 text-green-700 border border-green-200"
              }`}
            >
              {message}
            </div>
          )}

          <form method="POST" class="space-y-6 max-w-md">
            <div class="flex flex-col gap-1.5">
              <label class="text-m font-bold text-gray-900">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="email-input"
                placeholder="your@example.com"
                required
                class="rounded-lg border border-gray-200 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-blue/40 transition-all"
              />
              <p class="text-xs text-gray-500 mt-1">
                We'll send you a magic sign-in link via email.
              </p>
            </div>

            <div class="flex flex-col gap-3">
              <Button
                id="submit-btn"
                type="submit"
                variant="blue"
                size="lg"
                class="w-full justify-center"
              >
                Send Sign-In Link
              </Button>
              <p id="countdown-timer" class="text-xs text-gray-500 text-center hidden">
                Please wait <span id="timer-seconds">60</span> seconds before trying again.
              </p>
            </div>
          </form>

          <p class="text-xs text-gray-500 text-center mt-6">
            Only authorized users can access this page.
          </p>

		</Container>
	</Section>
</Layout>

<script>
  const form = document.querySelector("form");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const countdownTimer = document.getElementById("countdown-timer");
  const timerSeconds = document.getElementById("timer-seconds");
  const emailInput = document.getElementById("email-input") as HTMLInputElement;

  // Check if user is rate-limited on page load
  const savedEmail = localStorage.getItem("last-signin-email");
  const savedTime = localStorage.getItem("last-signin-time");

  if (savedEmail && savedTime) {
    const elapsed = (Date.now() - parseInt(savedTime)) / 1000;
    if (elapsed < 60) {
      const remaining = Math.ceil(60 - elapsed);
      startCountdown(remaining);
      emailInput.value = savedEmail;
    } else {
      localStorage.removeItem("last-signin-email");
      localStorage.removeItem("last-signin-time");
    }
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = emailInput.value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    localStorage.setItem("last-signin-email", email);
    localStorage.setItem("last-signin-time", Date.now().toString());

    form.submit();
  });

  function startCountdown(seconds: number) {
    submitBtn.disabled = true;
    countdownTimer?.classList.remove("hidden");

    const interval = setInterval(() => {
      seconds--;
      if (timerSeconds) {
        timerSeconds.textContent = seconds.toString();
      }

      if (seconds <= 0) {
        clearInterval(interval);
        submitBtn.disabled = false;
        countdownTimer?.classList.add("hidden");
        localStorage.removeItem("last-signin-email");
        localStorage.removeItem("last-signin-time");
      }
    }, 1000);
  }
</script>
