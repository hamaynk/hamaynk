---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";

// Page metadata
const title = "New England Armenian History Timeline";
const seoTitle = "New England Armenian History Timeline";
const seoDescription = "Events of note for Armenians and Armenian History in New England and the Boston metro area.";
---

<Layout {title} {seoTitle} {seoDescription}>
	<Section>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Learn about Armenians in New England</h1>
				<p>Armenians have been organizing events and getting together for almost two centuries.</p>
			</SectionHeading>

<iframe src='https://cdn.knightlab.com/libs/timeline3/latest/embed/index.html?source=v2%3A2PACX-1vQLXtv6ZfKYHtvkvmhjAYan2DdIcZj6sPKPDtf1Eh_87TKqpq3Bu_UZ5_8AuA-8yuA08_ncZ52VB-8q&font=Default&lang=en&initial_zoom=2&width=100%25&height=650' width='100%' height='650' webkitallowfullscreen mozallowfullscreen allowfullscreen frameborder='0'></iframe>

		</Container>
	</Section>
</Layout>
