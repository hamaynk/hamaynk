---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Container from "@/components/Container.astro";
import EventList from "@/components/EventList.astro";
import { ageGroupLabels, categoryLabels } from "@/utils/eventUtils";

const allPosts = await getCollection("events");
const sortedPosts = allPosts.sort(
	(a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);

const postsPerPage = 8;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

export function getStaticPaths() {
	const allPostsStatic = sortedPosts;
	const sortedPostsStatic = allPostsStatic.sort(
		(a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
	);
	const totalPagesStatic = Math.ceil(sortedPostsStatic.length / postsPerPage);

	return Array.from({ length: totalPagesStatic }, (_, i) => ({
		params: { page: String(i + 1) },
		props: {
			posts: sortedPostsStatic.slice(i * postsPerPage, (i + 1) * postsPerPage),
			currentPage: i + 1,
			totalPages: totalPagesStatic,
		},
	}));
}

interface Props {
	posts: typeof allPosts;
	currentPage: number;
	totalPages: number;
}

const { posts, currentPage, totalPages: pageTotal } = Astro.props;
const hasNextPage = currentPage < pageTotal;
const hasPrevPage = currentPage > 1;

const states = [...new Set(sortedPosts.map((p) => p.data.state))].sort();
const ageGroups = [...new Set(sortedPosts.flatMap((p) => ageGroupLabels(p.data.ageGroup)))].sort();
const interests = [...new Set(sortedPosts.flatMap((p) => categoryLabels(p.data.interests)))].sort();

// Page metadata
const title = `Events Listing - Page ${currentPage}`;
const seoTitle = "Armenian Events in New England";
const seoDescription = "A list of interesting Armenian events in New England and the Boston-metro area, with filters for location, interests, and age.";
---

<Layout {title} {seoTitle} {seoDescription}>
	<Section>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Events Listing</h1>
				<p>A list of interesting Armenian events in New England and the Boston-metro area, with filters for location, interests, and age.</p>
			</SectionHeading>

			<EventList />

			<!-- Pagination -->
			<div class="mt-8 flex justify-center gap-4">
				{hasPrevPage && (
					<a href={`/events/${currentPage - 1}`} class="px-4 py-2 bg-blue-600 text-white rounded">
						← Previous
					</a>
				)}
				<span class="px-4 py-2">
					Page {currentPage} of {pageTotal}
				</span>
				{hasNextPage && (
					<a href={`/events/${currentPage + 1}`} class="px-4 py-2 bg-blue-600 text-white rounded">
						Next →
					</a>
				)}
			</div>
		</Container>
	</Section>
</Layout>
