---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Container from "@/components/Container.astro";
import EventList from "@/components/EventList.astro";

const allPosts = await getCollection("events");
const sortedPosts = allPosts.sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);

// Page metadata
const title = "Events Listing";
const seoTitle = "Armenian Events in New England";
const seoDescription = "A list of interesting Armenian events in New England and the Boston-metro area, with filters for location, interests, and age.";
---


<Layout {title} {seoTitle} {seoDescription}>
	<Section>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Events Listing</h1>
				<p>A list of interesting Armenian events in New England and the Boston-metro area, with filters for date, location, interests, and age.</p>
			</SectionHeading>

			<EventList posts={sortedPosts} />
		</Container>
	</Section>
</Layout>
