---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import MainHeading from "@/components/MainHeading.astro";
import Button from "@/components/buttons/Button.astro";
import Video from "@/components/Video.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import EventList from "@/components/EventList.astro";
import FormNewsletter from "@/components/forms/FormNewsletter.astro";
import Faq from "@/components/Faq.astro";
---

<Layout title="Home - Elementary Astro">
	<Section class="relative">
		<Video
			class:list={"absolute inset-0 object-cover object-top w-full h-full z-0"}
			src="/8088625-hd_1280_720_30fps.mp4"
			autoplay
			muted
			loop
			playsinline
			overlay="bg-white/70 z-10"
		/>

		<Container class:list={"relative z-20"}>
			<MainHeading>
				<h1 class="text-5xl font-bold tracking-wide">Welcome to Hamaynk</h1>

				<p>
				    Hamaynk connects you to events in your community. More things it does, some other stuff, too. Here are other things we are doing. This is just filler text.
				</p>

				<div class="flex flex-wrap gap-4 justify-center md:justify-start">
				    <Button href="/contact" variant="red">About Us</Button>
					<Button href="#learn-more" variant="blue">Learn More</Button>
					<Button href="/contact" variant="yellow">Submit Event</Button>
				</div>
			</MainHeading>
		</Container>
	</Section>

	<Section>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Events List</h1>
				<p>Browse our curated list of interesting and fun events for Armenians in New England!</p>
			</SectionHeading>

			<EventList />
		</Container>
	</Section>

	<Section class:list={"bg-brand-blue text-white"}>
		<Container class:list={"lg:py-12"}>
			<SectionHeading>
				<h2 class="text-4xl font-bold tracking-wide">Stay in the Loop! 📬</h2>
				<p class="max-w-2xl mx-auto">
					Sign up for our weekly newsletter to get the latest news, events, and classroom highlights.
				</p>
			</SectionHeading>

			<FormNewsletter />
		</Container>
	</Section>

	<Section class:list={"bg-neutral-50"}>
		<Container>
			<SectionHeading>
				<h2 class="text-4xl font-bold tracking-wide">Frequently Asked Questions ❓</h2>
			</SectionHeading>

			<Faq />
		</Container>
	</Section>
</Layout>
