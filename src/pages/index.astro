---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import MainHeading from "@/components/MainHeading.astro";
import Button from "@/components/buttons/Button.astro";
import Video from "@/components/Video.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import EventPreview from "@/components/EventPreview.astro";
---

<Layout title="Home">
	<Section class="relative">
		<Video
			class:list={"absolute inset-0 object-cover object-top w-full h-full z-0"}
			src="/hamaynk-video-hero.mp4"
			autoplay
			muted
			loop
			playsinline
			overlay="bg-white/70 z-10"
		/>

		<Container class:list={"relative z-20"}>
			<MainHeading>
				<h1 class="text-5xl font-bold tracking-wide">Welcome to Hamaynk</h1>

				<p>
				    Hamaynk encourages participation and promotes connections among Armenians by providing a platform for attending and organizing events in New England
				</p>

				<div class="flex flex-wrap gap-4 justify-center md:justify-start">
				    <Button href="/about" variant="red">About Us</Button>
					<Button href="#events-list" variant="blue">Events List</Button>
					<Button href="/event-submission" variant="orange">Submit Event</Button>
				</div>
			</MainHeading>
		</Container>
	</Section>

	<Section id="events-list">
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Events List</h1>
				<p>Browse our curated list of interesting and fun events for Armenians in New England!</p>
			</SectionHeading>

			<EventPreview />
		</Container>
	</Section>

</Layout>
