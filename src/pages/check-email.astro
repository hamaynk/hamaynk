---
import Button from "@/components/buttons/Button.astro";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const email = Astro.url.searchParams.get("email");

// Page metadata
const title = "Check Your Email | Events Approval";
const seoTitle = "Check Your Email to Sign In";
const seoDescription = "Check your email for the sign-in link to access the events approval page";
---

<Layout {title} {seoTitle} {seoDescription}>
    <Section class:list={"bg-neutral-50"}>
		<Container>
			<SectionHeading>
				<h1 class="text-4xl font-bold tracking-wide">Check your email</h1>
			</SectionHeading>

			<div class="flex justify-center mb-8">
				<div class="bg-blue-100 rounded-full p-4">
					<svg
						class="w-8 h-8 text-brand-blue"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
						></path>
					</svg>
				</div>
			</div>

			<p class="text-gray-600 mb-2 text-center">
				Supabase has sent a sign-in link to:
			</p>
			<p class="text-brand-blue font-bold text-lg mb-8 text-center">
				{email || "your email"}
			</p>

			<div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 mb-8">
				<p class="text-m font-bold text-gray-900 mb-3">
					Next steps:
				</p>
				<ol class="text-m text-gray-700 space-y-2 ml-4 list-decimal">
					<li>Open the ”Your sign-in link” email that SUPABASE just sent</li>
					<li>Click the sign-in link</li>
					<li>You’ll be redirected to the events approval page</li>
				</ol>
			</div>

			<p class="text-xs text-gray-500 mb-8 text-center">
				The link expires in 24 hours. If you don’t see the email, check your
				spam folder.
			</p>

			<div class="flex justify-center">
				<Button href="/signin" variant="outline" size="md">
					← Back to Sign In
				</Button>
			</div>

		</Container>
	</Section>
</Layout>
