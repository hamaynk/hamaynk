---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import { interestBgColor, interestLabel } from "@/utils/diyUtils";

export async function getStaticPaths() {
	const posts = await getCollection("diy-guides");
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, seoTitle, seoDescription, description, interests } = entry.data || {};

// Normalize interests to array
const normalizedInterests = Array.isArray(interests)
	? interests
	: interests
		? [interests]
		: [];
---

<Layout {title} {description} {seoTitle} {seoDescription}>
	<Section class:list={"bg-neutral-50"}>
		<Container>
			<div class="max-w-3xl mx-auto">
				<a
					href="/diy-guides"
					class="inline-flex items-center gap-1 text-sm text-brand-foreground/60 hover:text-brand-foreground mb-8 transition-colors"
				>
					← See other DIY event guides
				</a>

				<div class="flex gap-4 mb-8">
					<div class={`w-2 shrink-0 rounded-full ${interestBgColor(normalizedInterests?.[0])}`}></div>
					<div class="flex-1">
						{normalizedInterests.length > 0 && (
							<div class="flex flex-wrap items-center gap-2 mb-3">
								{normalizedInterests.map((interest) => (
									<span class={`text-xs font-semibold text-white rounded-full px-3 py-1 ${interestBgColor(interest)}`}>
										{interestLabel(interest)}
									</span>
								))}
							</div>
						)}

						<h1 class="font-caveat-brush text-3xl lg:text-4xl text-brand-foreground font-bold leading-tight">
							{title}
						</h1>
					</div>
				</div>

				<div class="bg-white rounded-lg p-6 border border-neutral-200">
					{description && (
						<>
							<h2 class="font-caveat-brush text-2xl text-brand-foreground font-bold mb-3">About</h2>
							<p class="text-brand-foreground mb-6">
								{description}
							</p>
						</>
					)}
					<div class="prose prose-lg max-w-none font-nunito text-brand-foreground">
						<Content />
					</div>
				</div>
			</div>
		</Container>
	</Section>
</Layout>
