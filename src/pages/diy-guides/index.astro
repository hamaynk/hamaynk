---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import DiyGuideList from "@/components/DiyGuideList.astro";

// Page metadata
const title = "DIY Event Guides";
const description = "Learn how to plan and run your own community events with our collection of DIY event guides.";
const seoTitle = "DIY Event Guides";
const seoDescription = "Learn how to plan and run your own community events with our collection of DIY event guides.";
---

<Layout {title} {description} {seoTitle} {seoDescription}>
  <Section>
    <Container>
      <SectionHeading>
        <h1 class="text-4xl font-bold tracking-wide">DIY Event Guides 🎉</h1>
        <p>Learn how to plan and run your own community events with our collection of DIY guides.</p>
      </SectionHeading>
      <DiyGuideList />
    </Container>
  </Section>
</Layout>
