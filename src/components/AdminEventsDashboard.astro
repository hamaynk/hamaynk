---
// No backend code needed for this admin dashboard
---

<div class="p-6">
  <h1 class="text-2xl font-bold mb-6" id="event-title">Event Approval Dashboard</h1>

  <div class="mb-6 flex gap-4">
    <button id="filter-pending" class="px-4 py-2 bg-yellow-500 text-white rounded-lg">
      Pending (<span id="pending-count">0</span>)
    </button>
    <button id="filter-approved" class="px-4 py-2 bg-green-500 text-white rounded-lg">
      Approved (<span id="approved-count">0</span>)
    </button>
    <button id="filter-rejected" class="px-4 py-2 bg-red-500 text-white rounded-lg">
      Rejected (<span id="rejected-count">0</span>)
    </button>
  </div>

  <div id="events-list" class="space-y-4"></div>
</div>

<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://wryrgdxbdpkoifywcjsu.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_1wdg3gV-9czBMFctMqrZ3A_Ntimhr3C";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  let currentFilter = "pending";
  let allEvents: Event[] = [];
  let eventCounts = { pending: 0, approved: 0, rejected: 0 };

  type EventStatus = "pending" | "approved" | "rejected";

  interface Event {
    event_id: string;
    status: EventStatus;
    event_title: string;
    organizers: string;
    event_date: string;
    start_time: string;
    venue_city: string;
    venue_state: string;
    email: string;
    age_group: string;
    event_url: string;
    created_at?: string;
  }

  async function fetchEvents(status: string): Promise<Event[]> {
    try {
      const { data, error } = await supabase
        .from("events")
        .select("*")
        .eq("status", status)
        .order("created_at", { ascending: false });

      if (error) {
        console.error("Supabase error:", error);
        throw error;
      }

      return (data as Event[]) || [];
    } catch (err) {
      console.error("Error fetching events:", err);
      return [];
    }
  }

  async function fetchAllEventCounts() {
    const statuses: EventStatus[] = ["pending", "approved", "rejected"];

    for (const status of statuses) {
      const events = await fetchEvents(status);
      eventCounts[status] = events.length;
      updateCountDisplay(status, events.length);
    }
  }

  function updateCountDisplay(status: string, count: number) {
    const countElement = document.getElementById(`${status}-count`);
    if (countElement) {
      countElement.textContent = count.toString();
    }
  }

  async function updateEventStatus(
    eventId: string,
    newStatus: string
  ): Promise<void> {
    try {
      const { error } = await supabase
        .from("events")
        .update({ status: newStatus })
        .eq("event_id", eventId);

      if (error) {
        console.error("Supabase error:", error);
        throw error;
      }

      // Refresh counts and current view
      await fetchAllEventCounts();
      await renderEvents(currentFilter);
    } catch (err) {
      console.error("Error updating event:", err);
      alert("Failed to update event status");
    }
  }

  function renderEventCard(event: Event): string {
    const statusColor: Record<EventStatus, string> = {
      pending: "bg-yellow-100 text-yellow-800",
      approved: "bg-green-100 text-green-800",
      rejected: "bg-red-100 text-red-800",
    };

    const color = statusColor[event.status];

    return `
      <div class="border rounded-lg p-4 shadow-sm bg-white">
        <div class="flex justify-between items-start mb-3">
          <div>
            <h3 class="text-lg font-semibold">${event.event_title}</h3>
            <p class="text-sm text-gray-600">${event.organizers}</p>
          </div>
          <span class="px-3 py-1 rounded-full text-sm font-medium ${color}">
            ${event.status.charAt(0).toUpperCase() + event.status.slice(1)}
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2 text-sm mb-4">
          <p><strong>Date:</strong> ${event.event_date}</p>
          <p><strong>Time:</strong> ${event.start_time}</p>
          <p><strong>Location:</strong> ${event.venue_city}, ${event.venue_state}</p>
          <p><strong>Age Group:</strong> ${event.age_group}</p>
          <p><strong>Email:</strong> ${event.email}</p>
          <p><strong>URL:</strong> <a href="${event.event_url}" target="_blank" class="text-blue-500 underline">View</a></p>
        </div>

        <div class="flex gap-2">
          <button class="px-3 py-1 bg-green-500 text-white rounded text-sm hover:bg-green-600" onclick="window.updateEventStatus('${event.event_id}', 'approved')">
            Approve
          </button>
          <button class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600" onclick="window.updateEventStatus('${event.event_id}', 'rejected')">
            Reject
          </button>
          <button class="px-3 py-1 bg-yellow-500 text-white rounded text-sm hover:bg-yellow-600" onclick="window.updateEventStatus('${event.event_id}', 'pending')">
            Mark Pending
          </button>
        </div>
      </div>
    `;
  }

  async function renderEvents(status: string) {
    const eventsList = document.getElementById("events-list")!;
    const events = await fetchEvents(status);

    if (events.length === 0) {
      eventsList.innerHTML = `<p class="text-gray-500">No ${status} events found</p>`;
      return;
    }

    eventsList.innerHTML = events.map(renderEventCard).join("");
  }

  // Initialize on DOM ready
  function initializeDashboard() {
    // Setup filter buttons
    document.getElementById("filter-pending")?.addEventListener("click", async () => {
      currentFilter = "pending";
      await renderEvents("pending");
    });

    document.getElementById("filter-approved")?.addEventListener("click", async () => {
      currentFilter = "approved";
      await renderEvents("approved");
    });

    document.getElementById("filter-rejected")?.addEventListener("click", async () => {
      currentFilter = "rejected";
      await renderEvents("rejected");
    });

    // Make updateEventStatus globally available for onclick handlers
    (window as any).updateEventStatus = updateEventStatus;

    // Load initial data
    fetchAllEventCounts();
    renderEvents("pending");
  }

  // Run when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeDashboard);
  } else {
    initializeDashboard();
  }
</script>
