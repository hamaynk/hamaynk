---
import Mail from "~icons/heroicons/envelope";
import IconLogo from "@/assets/logo/arin-logo.svg";
import { siteName, email, siteSlogan } from "@/data/config";
---

<footer class="bg-brand-foreground text-white py-12 px-4">
	<div class="container">
		<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-8">
			<div class="lg:col-span-2">
				<a href="/" class="flex gap-x-4 items-center">
					<IconLogo class:list={"size-12"} />
					<span class="font-bold lowercase font-caveat-brush text-4xl">{siteName}</span>
				</a>
				<p class="font-body text-base mt-4">
					{siteSlogan}
				</p>
			</div>
			<div class="space-y-3 lg:col-start-5">
				<h3 class="font-body font-bold text-lg">Contact Us</h3>
				<div class="flex items-center gap-2 text-sm">
					<Mail class="w-4 h-4" />
					<a href={`${email.href}`}>{email.label}</a>
				</div>
				<div class="flex items-center gap-2 text-sm">
					<a href="https://instagram.com/hamaynk_ne">Instagram</a>
				</div>
			</div>
			<div class="space-y-3">
				<h3 class="font-body font-bold text-lg"><a href=/events-approval>Admin Portal</a></h3>
			</div>
		</div>
		<div class="border-t border-primary-foreground/20 mt-8 pt-6 text-center text-sm opacity-60 font-body">
			© {new Date().getFullYear()} Hamaynk. All rights reserved.

			<span class="block">
				Made with ❤️ by Hamaynk & <a
					href="https://www.lisagulesserian.com"
					class="font-bold"
					target="_blank"
					rel="noopener noreferrer">Lisa Gulesserian</a
				>
			</span>
		</div>
	</div>
</footer>
