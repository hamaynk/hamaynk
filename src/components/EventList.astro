---
import { getCollection } from "astro:content";
import { categoryBgColor, categoryLabel, formatDate } from "@/utils/eventUtils";
import LucideCalendar from "~icons/lucide/calendar";

const allPosts = await getCollection("events");
const posts = allPosts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Extract unique values for each filter category
const locations = [...new Set(posts.map((p) => p.data.location))].sort();
const ageGroups = [...new Set(posts.map((p) => p.data.ageGroup))].sort();
const interests = [...new Set(posts.flatMap((p) => p.data.interests))].sort();
---

<div class="max-w-3xl mx-auto">
	<!-- Location Filter -->
	<div class="mb-8">
		<h3 class="text-sm font-semibold text-brand-foreground mb-3">Location</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-location bg-brand-red text-white border-brand-red px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Locations
			</button>
			{
				locations.map((loc) => (
					<button
						class="filter-btn filter-location bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={loc}
					>
						{categoryLabel(loc)}
					</button>
				))
			}
		</div>
	</div>

	<!-- Age Group Filter -->
	<div class="mb-8">
		<h3 class="text-sm font-semibold text-brand-foreground mb-3">Age Group</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-agegroup bg-brand-blue text-white border-brand-blue px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Ages
			</button>
			{
				ageGroups.map((age) => (
					<button
						class="filter-btn filter-agegroup bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={age}
					>
						{categoryLabel(age)}
					</button>
				))
			}
		</div>
	</div>

	<!-- Interests Filter -->
	<div class="mb-8">
		<h3 class="text-sm font-semibold text-brand-foreground mb-3">Interests</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-interests bg-brand-yellow text-white border-brand-yellow px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Interests
			</button>
			{
				interests.map((interest) => (
					<button
						class="filter-btn filter-interests bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={interest}
					>
						{categoryLabel(interest)}
					</button>
				))
			}
		</div>
	</div>

	<!-- No events message -->
	<div
		id="no-events-message"
		class="hidden text-center py-12 px-6 bg-brand-foreground/5 rounded-xl mb-8"
	>
		<p class="text-brand-foreground mb-4">
			No events found. <a
				href="/diy-guides"
				class="text-brand-blue font-semibold hover:underline"
			>
				Host your own with our DIY event guides!
			</a>
		</p>
	</div>

	<!-- Event list -->
	<div class="flex flex-col gap-6 mt-8" id="events-container">
		{
			posts.map((post) => (
				<div
					class="blog-item"
					data-location={post.data.location}
					data-agegroup={post.data.ageGroup}
					data-interests={post.data.interests.join(',')}
				>
					<article class="flex bg-white rounded-xl relative hover:translate-x-2 transition shadow-sm hover:shadow-md overflow-hidden">
						<div class={`w-2 shrink-0 ${categoryBgColor(post.data.location)}`} />
						<div class="flex-1 p-5">
							<div class="flex items-center gap-3 mb-2 flex-wrap">
								<span class="text-xs font-semibold bg-[#feca4f] rounded-full px-2 py-1">
									{categoryLabel(post.data.location)}
								</span>
								<span class="text-xs font-semibold bg-blue-100 text-blue-800 rounded-full px-2 py-1">
									{categoryLabel(post.data.ageGroup)}
								</span>
								<span class="text-sm text-brand-foreground/50 flex items-center">
									<LucideCalendar class="inline-block size-4 mr-1" />
									{formatDate(post.data.date)}
								</span>
							</div>

							<h2 class="text-xl font-semibold mb-2">{post.data.title}</h2>

							<div class="flex flex-wrap gap-2 mb-3">
								{post.data.interests.map((interest) => (
									<span class="text-xs bg-green-100 text-green-800 rounded px-2 py-1">
										{categoryLabel(interest)}
									</span>
								))}
							</div>

							<a href={`/events/${post.id}`} class="text-brand-blue text-base font-bold">
								More info →
								<span class="absolute inset-0" />
							</a>
						</div>
					</article>
				</div>
			))
		}
	</div>
</div>

<script>
	const locationButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-location"
	);
	const ageGroupButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-agegroup"
	);
	const interestButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-interests"
	);
	const items = document.querySelectorAll<HTMLElement>(".blog-item");
	const noEventsMessage = document.getElementById("no-events-message");

	const activeClasses = ["bg-brand-blue", "text-white", "border-brand-blue"];
	const inactiveClasses = [
		"bg-white",
		"text-brand-foreground",
		"border-brand-foreground/20",
		"hover:border-brand-foreground",
	];

	let activeFilters = {
		location: "all",
		ageGroup: "all",
		interests: "all",
	};

	const updateFilters = () => {
		let visibleCount = 0;

		items.forEach((item) => {
			const itemLocation = item.dataset.location;
			const itemAgeGroup = item.dataset.agegroup;
			const itemInterests = item.dataset.interests?.split(",") ?? [];

			const locationMatch =
				activeFilters.location === "all" ||
				itemLocation === activeFilters.location;
			const ageGroupMatch =
				activeFilters.ageGroup === "all" ||
				itemAgeGroup === activeFilters.ageGroup;
			const interestsMatch =
				activeFilters.interests === "all" ||
				itemInterests.includes(activeFilters.interests);

			const match = locationMatch && ageGroupMatch && interestsMatch;
			item.classList.toggle("hidden", !match);

			if (match) {
				visibleCount++;
			}
		});

		// Show/hide no events message
		if (visibleCount === 0) {
			noEventsMessage?.classList.remove("hidden");
		} else {
			noEventsMessage?.classList.add("hidden");
		}
	};

	locationButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.location = btn.dataset.filter ?? "all";
			locationButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});

	ageGroupButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.ageGroup = btn.dataset.filter ?? "all";
			ageGroupButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});

	interestButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.interests = btn.dataset.filter ?? "all";
			interestButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});
</script>
