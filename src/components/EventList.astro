---
import { getCollection } from "astro:content";
import {
  stateBgColor,
  categoryLabels,
  ageGroupLabels,
  formatDate,
  getDateCategory,
  getAllDateCategories,
  getDateCategoryLabel
} from "@/utils/eventUtils";
import LucideCalendar from "~icons/lucide/calendar";

const allPosts = await getCollection("events");

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());

const posts = allPosts
  .filter((event) => event.data.date >= startOfToday) // today + future
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime()); // sorted

// Extract unique values for each filter category
const states = [...new Set(posts.map((p) => p.data.state))].sort();
const ageGroups = [...new Set(posts.flatMap((p) => ageGroupLabels(p.data.ageGroup)))].sort();
const interests = [...new Set(posts.flatMap((p) => categoryLabels(p.data.interests)))].sort();
const dates = getAllDateCategories(posts.map((p) => p.data.date));
---

<div class="max-w-3xl mx-auto">
	<!-- Date Filter -->
	<div class="mb-8">
		<h3 class="text-lg font-semibold text-brand-foreground mb-3">Date</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-date bg-brand-green text-white border-brand-green px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Dates
			</button>
			{
				dates.map((dateCategory) => (
					<button
						class="filter-btn filter-date bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={dateCategory}
					>
						{getDateCategoryLabel(dateCategory)}
					</button>
				))
			}
		</div>
	</div>

	<!-- State Filter -->
	<div class="mb-8">
		<h3 class="text-lg font-semibold text-brand-foreground mb-3">Location</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-state bg-brand-red text-white border-brand-red px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Locations
			</button>
			{
				states.map((state) => (
					<button
						class="filter-btn filter-state bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={state}
					>
						{state}
					</button>
				))
			}
		</div>
	</div>

	<!-- Age Group Filter -->
	<div class="mb-8">
		<h3 class="text-lg font-semibold text-brand-foreground mb-3">Recommended Age Group</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-agegroup bg-brand-blue text-white border-brand-blue px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Age Groups
			</button>
			{
				ageGroups.map((age) => (
					<button
						class="filter-btn filter-agegroup bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={age}
					>
						{age}
					</button>
				))
			}
		</div>
	</div>

	<!-- Interests Filter -->
	<div class="mb-8">
		<h3 class="text-lg font-semibold text-brand-foreground mb-3">Interests</h3>
		<div class="flex flex-wrap gap-2 justify-start">
			<button
				class="filter-btn filter-interests bg-brand-yellow text-white border-brand-yellow px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
				data-filter="all"
			>
				All Interests
			</button>
			{
				interests.map((interest) => (
					<button
						class="filter-btn filter-interests bg-white text-brand-foreground border-brand-foreground/20 hover:border-brand-foreground px-4 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer"
						data-filter={interest}
					>
						{interest}
					</button>
				))
			}
		</div>
	</div>

	<!-- No events message -->
	<div
		id="no-events-message"
		class="hidden text-center py-12 px-6 bg-white rounded-xl mb-8"
	>
		<p class="text-brand-foreground mb-4">
			No events found. <a
				href="/hamaynk/diy-guides"
				class="text-blue-600 font-bold hover:underline"
			>
				Host your own with our DIY event guides!
			</a>
		</p>
	</div>

	<!-- Event list -->
	<div class="flex flex-col gap-6 mt-8" id="events-container">
		{
			posts.map((post) => (
				<div
					class="blog-item"
					data-date={getDateCategory(post.data.date)}
					data-state={post.data.state}
					data-agegroup={ageGroupLabels(post.data.ageGroup).join(',')}
					data-interests={categoryLabels(post.data.interests).join(',')}
				>
					<article class="flex bg-white rounded-xl relative hover:translate-x-2 transition shadow-sm hover:shadow-md overflow-hidden">
						<div class={`w-2 shrink-0 ${stateBgColor(post.data.state)}`} />
						<div class="flex-1 p-5">
							<div class="flex items-center gap-3 mb-2 flex-wrap">
								<span class="text-xs font-semibold bg-[#feca4f] rounded-full px-2 py-1">
									{post.data.state}
								</span>
								{ageGroupLabels(post.data.ageGroup).map((group) => (
									<span class="text-xs font-semibold bg-blue-100 text-blue-800 rounded-full px-2 py-1">
										{group}
									</span>
								))}
								<span class="text-sm text-brand-foreground/50 flex items-center">
									<LucideCalendar class="inline-block size-4 mr-1" />
									{formatDate(post.data.date)}
								</span>
							</div>

							<h2 class="text-xl font-semibold mb-2">{post.data.title}</h2>

							<div class="flex flex-wrap gap-2 mb-3">
								{categoryLabels(post.data.interests).map((interest) => (
									<span class="text-xs bg-green-100 text-green-800 rounded px-2 py-1">
										{interest}
									</span>
								))}
							</div>

							<a href={`/hamaynk/events/${post.id}`} class="text-brand-blue text-base font-bold">
								More info →
								<span class="absolute inset-0" />
							</a>
						</div>
					</article>
				</div>
			))
		}
	</div>
</div>

<script>
	import { getDateCategory } from "@/utils/eventUtils";

	const dateButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-date"
	);
	const stateButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-state"
	);
	const ageGroupButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-agegroup"
	);
	const interestButtons = document.querySelectorAll<HTMLButtonElement>(
		".filter-interests"
	);
	const items = document.querySelectorAll<HTMLElement>(".blog-item");
	const noEventsMessage = document.getElementById("no-events-message");

	const activeClasses = ["bg-brand-blue", "text-white", "border-brand-blue"];
	const inactiveClasses = [
		"bg-white",
		"text-brand-foreground",
		"border-brand-foreground/20",
		"hover:border-brand-foreground",
	];

	let activeFilters = {
		date: "all",
		state: "all",
		ageGroup: "all",
		interests: "all",
	};

	const updateFilters = () => {
		let visibleCount = 0;

		items.forEach((item) => {
			const itemDate = item.dataset.date;
			const itemState = item.dataset.state;
			const itemAgeGroup = item.dataset.agegroup;
			const itemInterests = item.dataset.interests?.split(",") ?? [];

			const dateMatch =
			   activeFilters.date === "all" ||
			   itemDate === activeFilters.date ||
			   (activeFilters.date === "this-month" && itemDate === "this-week");
			const stateMatch =
				activeFilters.state === "all" ||
				itemState === activeFilters.state;
			const ageGroupMatch =
				activeFilters.ageGroup === "all" ||
				itemAgeGroup === activeFilters.ageGroup;
			const interestsMatch =
				activeFilters.interests === "all" ||
				itemInterests.includes(activeFilters.interests);

			const match = dateMatch && stateMatch && ageGroupMatch && interestsMatch;
			item.classList.toggle("hidden", !match);

			if (match) {
				visibleCount++;
			}
		});

		// Show/hide no events message
		if (visibleCount === 0) {
			noEventsMessage?.classList.remove("hidden");
		} else {
			noEventsMessage?.classList.add("hidden");
		}
	};

	dateButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.date = btn.dataset.filter ?? "all";
			dateButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});

	stateButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.state = btn.dataset.filter ?? "all";
			stateButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});

	ageGroupButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.ageGroup = btn.dataset.filter ?? "all";
			ageGroupButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});

	interestButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilters.interests = btn.dataset.filter ?? "all";
			interestButtons.forEach((b) => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			updateFilters();
		});
	});
</script>
