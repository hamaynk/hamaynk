---
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  variant?: 'card' | 'offset' | 'hero' | 'thumbnail';
  class?: string;
  isGif?: boolean;
}

const {
  src,
  alt,
  variant = 'card',
  class: customClass,
  isGif = false,
} = Astro.props;

const imageSrc = typeof src === 'string' ? src : src.src;

const variantClasses = {
  card: 'w-full h-48 sm:h-64',
  offset: 'w-full h-48 sm:h-64',
  hero: 'w-full h-56 sm:h-96',
  thumbnail: 'w-20 sm:w-24 h-20 sm:h-24',
};

// Simple CSS rotation angles
const rotations = ['2deg', '-3deg', '1.5deg', '-2.5deg'];
const rotationIndex = Math.floor(Math.random() * rotations.length);
const rotation = rotations[rotationIndex];
---

{isGif ? (
  <img
    src={imageSrc}
    alt={alt}
    class="max-w-full max-h-96 object-contain"
    loading="eager"
  />
) : (
  <div
    class={`${variantClasses[variant]} ${customClass || ''}`}
    style={`
      background: white;
      border: 2px solid #000;
      padding: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      transform: rotate(${rotation});
      flex-shrink: 0;
    `}
  >
    <img
      src={imageSrc}
      alt={alt}
      loading="eager"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover; display: block;"
    />
  </div>
)}
