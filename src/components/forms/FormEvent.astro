---
export const prerender = false;

import Button from "@/components/buttons/Button.astro";

// Server-side code runs only on the server
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let formMessage = "";
let isError = false;

// Handle form submission
if (Astro.request.method === "POST") {
	try {
		const formData = await Astro.request.formData();

		// Extract interests (multiple checkboxes)
		const interests = formData.getAll("interest") as string[];

		if (interests.length === 0) {
			formMessage = "Please select at least one interest.";
			isError = true;
		} else {
			const payload = {
				event_id: crypto.randomUUID(),
				email: formData.get("email"),
				organizers: formData.get("organizers"),
				event_title: formData.get("title"),
				venue_address: formData.get("venue_address"),
				venue_city: formData.get("venue_city"),
				venue_state: formData.get("venue_state"),
				event_url: formData.get("event_url"),
				event_date: formData.get("event_date"),
				start_time: formData.get("start_time"),
				price: formData.get("price"),
				age_group: formData.get("age_group"),
				interest: interests.join(", "),
				event_description: formData.get("description"),
				source: "form",
				status: "pending",
			};

			// Submit to Supabase
			const res = await fetch(`${SUPABASE_URL}/rest/v1/events`, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					apikey: SUPABASE_ANON_KEY,
					Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
					Prefer: "return=minimal",
				},
				body: JSON.stringify(payload),
			});

			if (!res.ok) {
				const err = await res.text();
				throw new Error(err || `Request failed (${res.status})`);
			}

			formMessage = "Event submitted. It will appear on our site if approved. 🎉";
			isError = false;
		}
	} catch (err) {
		console.error(err);
		formMessage = "Something went wrong submitting your event. Please try again.";
		isError = true;
	}
}
---

<form id="event-form" class="flex flex-col gap-4" method="POST">
	<!-- Hidden honeypot -->
	<input
		type="text"
		name="website"
		style="display: none;"
		tabindex="-1"
		autocomplete="off"
	/>

	<!-- ... all your form fields stay exactly the same ... -->

	<Button type="submit" variant="blue" size="lg" class="w-full justify-center">Submit Event 🎉</Button>

	{formMessage && (
		<p class={`text-m ${isError ? "text-red-600" : "text-green-600"}`}>
			{formMessage}
		</p>
	)}
</form>

<script>
	const form = document.getElementById("event-form") as HTMLFormElement;

	// Basic rate limiting (per session)
	function checkRateLimit(): boolean {
		const lastSubmitTime = sessionStorage.getItem("lastFormSubmit");
		const now = Date.now();

		if (lastSubmitTime) {
			const timeSinceLastSubmit = now - parseInt(lastSubmitTime);
			// Minimum 2 seconds between submissions
			if (timeSinceLastSubmit < 2000) {
				alert("Please wait before submitting again.");
				return false;
			}
		}

		sessionStorage.setItem("lastFormSubmit", now.toString());
		return true;
	}

	// Honeypot validation
	function isSpamSubmission(): boolean {
		const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
		return honeypot !== null && honeypot.value.length > 0;
	}

	form?.addEventListener("submit", (e) => {
		// Check honeypot
		if (isSpamSubmission()) {
			console.warn("Spam submission detected (honeypot)");
			// Still submit silently to confuse bots
			return;
		}

		// Check rate limiting
		if (!checkRateLimit()) {
			e.preventDefault();
			return;
		}

		const interests = form.querySelectorAll<HTMLInputElement>('input[name="interest"]:checked');
		if (interests.length === 0) {
			e.preventDefault();
			alert("Please select at least one interest.");
		}
	});
</script>
